# ==============================================================================
# SSL/TLS CERTIFICATES AND KEYS
# ==============================================================================
# SECURITY: Never commit certificates or private keys to version control
*.crt
*.key
*.pem
*.p12
*.pfx
*.cer
*.der
# Certificate directories
**/certs/
**/ssl/
**/certificates/

# ==============================================================================
# DOCKER VOLUMES AND DATA
# ==============================================================================
# Docker volumes and data (if bind-mounted locally)
# Note: Named volumes in docker-compose.yml don't create local directories
# but this protects against future bind mounts
/docker-volumes/
/backend-data/
/frontend-dist/

# Environment files (contain sensitive data)
.env
.env.local
.env.*.local

# GENERATED FILES (staging-setup.sh, prod-setup.sh output)
# Templates (*.template) are committed; generated files are not.
.generated/

# Docker build artifacts
docker-compose.override.yml

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
Thumbs.db
.DS_Store

# Local development
.cache/
.tmp/
temp/

# Python local development (should use venv, not system packages)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/

# Node local development (npm dependencies)
node_modules/

# Build outputs
dist/
build/
*.egg-info/

# Claude Code local files (settings, memory) — keep private
.claude/
CLAUDE.local.md

# Autogenerated by staging-setup.sh / prod-setup.sh — contains a real client secret
prf-keycloak/prf-keycloak-admin.env

# Autogenerated by staging-setup.sh / prod-setup.sh — DB passwords (volume-coupled)
prf-mariadb/mariadb.env

# Rendered output of jinja-gen (generated artifacts — never track)
jinja-build/

# Extraction mirror of pol-services/ annotated sources (generated)
jinja-templates/
