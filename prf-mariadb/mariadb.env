# ==============================================================================
# POLARI RESEARCH FRAMEWORK - MARIADB CREDENTIALS
# ==============================================================================
# Dev defaults — staging-setup.sh / prod-setup.sh overwrites this file at
# bootstrap time with secure values (or operator-supplied creds).
#
# Standalone-PRF deployments load this file via the prf-mariadb container's
# env_file directive; .generated/.env.staging or .env.prod adds the values
# that vary by environment.
# ==============================================================================

MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=keycloak

# Keycloak DB user — must match keycloak-prf.conf db-username/password.
KC_DB_NAME=keycloak
KC_DB_USER=kc
KC_DB_PASSWORD=kcpassword

# Polari object-DB user (backends running database.type: mariadb).
POLARI_DB_USER=polari
POLARI_DB_PASSWORD=polaripassword
