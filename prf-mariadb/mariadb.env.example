# ==============================================================================
# POLARI RESEARCH FRAMEWORK - MARIADB CREDENTIALS — EXAMPLE
# ==============================================================================
# The real prf-mariadb/mariadb.env is AUTOGENERATED (random passwords) by
# staging-setup.sh / prod-setup.sh — run one before `docker compose up`.
# Override knobs: POLARI_MARIADB_ROOT_PASS, POLARI_KC_DB_PASS,
# POLARI_OBJECTS_DB_PASS (export before running the setup script).
#
# Passwords are baked into the DB volume at FIRST init — the generators never
# overwrite an existing file, so regeneration implies a fresh prf-mariadb
# volume. prf-keycloak receives KC_DB_PASSWORD from this file via env_file
# (env vars override the baked keycloak-prf.conf).
# ==============================================================================

MARIADB_ROOT_PASSWORD=REPLACE_ME_RUN_staging-setup.sh
MARIADB_DATABASE=keycloak

KC_DB_NAME=keycloak
KC_DB_USER=kc
KC_DB_PASSWORD=REPLACE_ME_RUN_staging-setup.sh

# Polari object-DB user (backends running database.type: mariadb).
# docker-compose.dbcombo.yml's MARIADB_PASSWORD knob must match this value.
POLARI_DB_USER=polari
POLARI_DB_PASSWORD=REPLACE_ME_RUN_staging-setup.sh
