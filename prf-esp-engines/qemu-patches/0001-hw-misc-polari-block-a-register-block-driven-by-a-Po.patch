diff --git a/include/hw/misc/polari_block.h b/include/hw/misc/polari_block.h
new file mode 100644
index 0000000..2cd09c0
--- /dev/null
+++ b/include/hw/misc/polari_block.h
@@ -0,0 +1,63 @@
+/*
+ * polari-block: a register block driven by a Polari device layout (polari-block-layout/1)
+ *
+ * Copyright (c) 2026 Polari contributors
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+#ifndef HW_MISC_POLARI_BLOCK_H
+#define HW_MISC_POLARI_BLOCK_H
+
+#include "hw/sysbus.h"
+#include "qemu/notify.h"
+
+#define TYPE_POLARI_BLOCK "polari-block"
+OBJECT_DECLARE_SIMPLE_TYPE(PolariBlockState, POLARI_BLOCK)
+
+/* overlay priority: above the vendor model (0), so only the mapped runs are ours and every other offset falls through */
+#define POLARI_BLOCK_PRIORITY 1
+
+typedef enum {
+    PB_RW, PB_R, PB_W1SET, PB_W1CLR, PB_WSTROBE, PB_RW1C, PB_RWSC, PB_W1C, PB_W0C,
+} PolariAccess;
+
+typedef struct PolariField {
+    char *name;
+    uint8_t lo, width;
+    PolariAccess access;
+    int acts_on;                /* register index a w1-set / w1-clear field acts on, else -1 */
+} PolariField;
+
+typedef struct PolariReg {
+    char *name;
+    uint32_t addr;
+    uint32_t reset, value;
+    int nfields;
+    PolariField *fields;
+} PolariReg;
+
+typedef struct PolariRun {
+    PolariBlockState *s;
+    MemoryRegion mr;
+    uint32_t base;              /* absolute address of the run's first register */
+    int first;                  /* index of that register; the run's registers are contiguous */
+    int count;
+} PolariRun;
+
+struct PolariBlockState {
+    SysBusDevice parent_obj;
+    char *layout;               /* path of the layout JSON (property) */
