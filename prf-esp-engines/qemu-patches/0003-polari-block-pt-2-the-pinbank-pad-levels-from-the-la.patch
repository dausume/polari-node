+/* the pinbank roles the device runs (PIN_TWIN_PLAN.md §2; names = the layout's role keys, bound per chip in hal soc_rules) */
+typedef enum {
+    PR_OUTPUT, PR_DIRECTION, PR_INPUT, PR_PULL_UP, PR_PULL_DOWN, PR_PAD_IE, PR_PAD_FUNCTION, PR_OUTPUT_ROUTE,
+    PR_OUTPUT_ENABLE_SOURCE, PR_OUTPUT_DRIVER, PR_OUTPUT_INVERT, PR_ENABLE_INVERT, PR_EDGE_SENSE, PR_LEVEL_SENSE,
+    PR_EDGE_MASK, PR_EDGE_FLAG, PR_CPU_STATUS, PR_COUNT
+} PolariRole;
+
+typedef struct PolariRef {
+    int reg, field;             /* the STORED field a role reads for one pin (an alias-only role resolves through acts_on) */
+} PolariRef;
+
+#define POLARI_MAX_PINS 64
+
+typedef struct PolariPin {
+    PolariRef role[PR_COUNT];
+    uint32_t gpio_functions;    /* bit k set = pad function k is this pad's GPIO */
+    char level;                 /* '0' '1' 'z': the pad's level as last computed */
+    char ext;                   /* '0' '1' 'z': driven from outside (the pin channel); 'z' = not driven */
+    bool warned_route, warned_pulls;
+} PolariPin;
+
 struct PolariBlockState {
     SysBusDevice parent_obj;
     char *layout;               /* path of the layout JSON (property) */
@@ -56,6 +78,14 @@ struct PolariBlockState {
     int nruns;
     PolariRun *runs;
     uint64_t writes, unmodelled;
+    /* the pinbank (pt-2) */
+    int npins;
+    PolariPin pins[POLARI_MAX_PINS];
+    uint32_t v_gpio_out, v_open_drain, v_out_inverted, v_en_inverted, v_ie_on, v_oen_gpio;
+    CharBackend chr;            /* the pin channel: out "@<virtual ns> <pin> 0|1|z", in "<pin> 0|1|z" */
+    char rx[64];
+    int rxn;
+    uint64_t edges;
     qemu_irq irq;
     Notifier exit_notifier;
 };
