# ==============================================================================
# PRF KEYCLOAK ADMIN CREDENTIALS — EXAMPLE (the real file is gitignored)
# ==============================================================================
# The real prf-keycloak-admin.env is AUTOGENERATED with a random client secret
# by staging-setup.sh / prod-setup.sh — run one of those before `docker compose
# up`. configure_clients.sh PATCHes the secret into Keycloak on each startup,
# so re-running a setup script rotates it cleanly.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Service-account secret for the polari-backend confidential client.
KEYCLOAK_POLARI_BACKEND_CLIENT_SECRET=REPLACE_ME_RUN_staging-setup.sh
