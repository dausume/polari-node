# ==============================================================================
# PRF KEYCLOAK ADMIN CREDENTIALS — EXAMPLE (the real file is gitignored)
# ==============================================================================
# All security values are put in AT DEPLOY TIME: the real
# prf-keycloak-admin.env is generated with random secrets by
# staging-setup.sh / prod-setup.sh (`pol security node-setup`) — run one of
# those before `docker compose up`.
#
# The values below are INTENTIONALLY EMPTY and this file must never be
# copied into place as-is: configure_clients.sh SKIPs the client-secret
# PATCH when the value is empty, so a missed setup fails closed instead of
# installing a public string from a tracked file as the live secret.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Service-account secret for the polari-backend confidential client.
KEYCLOAK_POLARI_BACKEND_CLIENT_SECRET=
