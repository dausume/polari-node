# GENERATED from jinja-templates/docker-compose.twin-b.yml.j2 —
# edit the template + setup.yml (variants.twin_b), then:
#   ansible-playbook jinja-gen/playbook.yml
# (env: {{ active_env_name }})
#
# POLARI TWIN — INSTANCE B (shared-infra twin of the staging stack)
# Instance A = the staging-nip stack, UNTOUCHED. Instance B = a second
# backend + frontend REUSING A's images and A's shared infrastructure
# (Keycloak, MariaDB, MinIO) over A's compose network, plus the dedicated
# polari-link peer network. Launch via ./twin-polari-build.sh (creates
# polari-link, generates B's runtime config + peer token, runs the
# peer-registration handshake). B serves PLAIN HTTP on explicit host ports.
{% import 'compose_macros.jinja' as m %}
{% set v = variants.twin_b %}
{% set c = variants.common %}

services:
  backend-b:
    image: prf-backend:{{ v.reused_image_tag }}   # REUSED — never built here
    container_name: prf-b-backend
    restart: unless-stopped
    networks:
      - {{ c.link_network }}
      - a-net                            # shared keycloak/mariadb/minio live here
    ports:
      - "{{ v.backend.api_port }}:3000"  # B's API, plain HTTP
      - "{{ v.backend.ws_port }}:3001"   # B's STOMP websocket
    env_file:
      - {{ v.generated_env }}
      - {{ c.kc_admin_env }}
    environment:
      - DEPLOY_ENV=staging
      - IN_DOCKER_CONTAINER=true
      - INTERNAL_API_URL=http://localhost:3000
      - DATABASE_TYPE=sqlite
      - DATABASE_PATH={{ c.database_path }}
      - OBJECT_STORAGE_ENABLED=true
      - MINIO_ENDPOINT={{ c.minio_endpoint }}
      - MINIO_ACCESS_KEY={{ c.minio_user }}
      - MINIO_SECRET_KEY={{ c.minio_password }}
      - WEBSOCKET_ENABLED=true
      - WEBSOCKET_PORT=3001
      # --- twin identity + peer trust (set by twin-polari-build.sh) ---
      - POLARI_INSTANCE_ID={{ v.instance_id }}
      - POLARI_INSTANCE_NAME={{ v.instance_name }}
      - POLARI_PEER_TOKEN=${POLARI_PEER_TOKEN:?run twin-polari-build.sh}
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:3000/', timeout=5)"]
      interval: 10s
      timeout: 10s
      # Startup replays the DB persistence pass before SERVER READY; give it
      # the same generous window as the A-node.
      start_period: {{ v.backend.healthcheck_start_period }}
      retries: {{ v.backend.healthcheck_retries }}
    volumes:
      - backend-b-data:/app/data
{{ m.deploy_resources(v.backend.deploy) }}

  frontend-b:
    image: prf-frontend:{{ v.reused_image_tag }}  # REUSED
    container_name: prf-b-frontend
    restart: unless-stopped
    networks:
      - {{ c.link_network }}
    ports:
      - "{{ v.frontend.port }}:4200"     # B's UI, plain HTTP (nginx on 4200)
    volumes:
      - {{ v.frontend.runtime_config }}:/usr/share/nginx/html/assets/runtime-config.json:ro
    depends_on:
      - backend-b
{{ m.deploy_resources(v.frontend.deploy) }}

volumes:
  backend-b-data:

networks:
  {{ c.link_network }}:
    external: true                       # created by twin-polari-build.sh
  a-net:
    external: true
    name: {{ v.a_net_name }}
