# GENERATED from jinja-templates/docker-compose.remote-worker.yml.j2 —
# edit the template + setup.yml, then: ansible-playbook jinja-gen/playbook.yml
# (env: {{ active_env_name }})
#
# Core-and-remote variant: runs on a REMOTE machine, reaching the core at
# a manually-entered CORE_IP (default from setup.yml).

services:
  msci-engines:
    build:
      context: ./msci-engines
    image: prf-msci-engines:{{ remote_worker.engines_image_tag }}
    container_name: prf-msci-engines
    restart: unless-stopped
    ports:
      - "{{ msci_engines.port }}:9500"
    mem_limit: {{ msci_engines.mem_limit }}

  dask-worker:
    profiles: ["dask"]
    image: prf-backend:{{ tier }}
    container_name: prf-remote-dask-worker
    command: ["/opt/venv/bin/dask", "worker",
              "tcp://${CORE_IP:-{{ remote_worker.core_ip_default }}}:${DASK_SCHEDULER_PORT:-{{ remote_worker.scheduler_port_default }}}",
              "--name", "${WORKER_NAME:-remote}-worker",
              "--nthreads", "2", "--memory-limit", "700MB",
              "--no-dashboard"]
    environment:
      - PYTHONPATH=/app
    restart: unless-stopped
    mem_limit: 768m
