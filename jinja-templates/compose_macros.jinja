{#- ==========================================================================
    compose_macros.jinja — shared service blocks for the docker-compose
    variant templates. Deliberately NOT *.j2: the playbook renders every
    .j2 it finds, and this file is only ever {% import %}-ed (Ansible puts
    the template's own directory on the Jinja search path, so variant
    templates import it by bare filename).

    Every macro takes (cfg, common):
      cfg    = variants.<variant>.<service>  (per-variant knobs, setup.yml)
      common = variants.common               (shared names/credentials)
    and emits one service block indented for a top-level `services:` key.
    `${VAR}` strings are docker-compose interpolation and must survive into
    the rendered file verbatim — jinja leaves them alone by design.
   ========================================================================== -#}

{#- deploy.resources block from a {limits: {...}, reservations: {...}} dict.
    reservations are optional (twin-b's frontend sets limits only). -#}
{%- macro deploy_resources(d) %}
    deploy:
      resources:
        limits:
          memory: {{ d.limits.memory }}
          cpus: '{{ d.limits.cpus }}'
{% if d.reservations is defined %}
        reservations:
          memory: {{ d.reservations.memory }}
          cpus: '{{ d.reservations.cpus }}'
{% endif %}
{%- endmacro %}

{#- MariaDB — consolidated DB for prf-keycloak (+ future PRF storage).
    knobs: image_tag, container_name, network, extra_env_file, data_volume
    ('' = ephemeral), restart, healthcheck_interval/retries, command, deploy -#}
{%- macro mariadb(cfg, common) %}
  prf-mariadb:
    build:
      context: ./prf-mariadb
      dockerfile: Dockerfile
    container_name: {{ cfg.container_name | default('prf-mariadb') }}
    image: prf-mariadb:{{ cfg.image_tag }}
    restart: "{{ cfg.restart | default('always') }}"
    networks:
      - {{ cfg.network | default(common.node_network) }}
    env_file:
      - {{ common.mariadb_env }}
{% for f in cfg.extra_env_file | default([]) %}
      - {{ f }}
{% endfor %}
{% if cfg.data_volume | default('prf-mariadb-data') %}
    volumes:
      - {{ cfg.data_volume | default('prf-mariadb-data') }}:/var/lib/mysql
{% endif %}
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      start_period: 10s
      interval: {{ cfg.healthcheck_interval | default('10s') }}
      timeout: 5s
      retries: {{ cfg.healthcheck_retries | default(3) }}
{% if cfg.command | default('') %}
    command: >
      {{ cfg.command }}
{% endif %}
{% if cfg.deploy is defined %}
{{ deploy_resources(cfg.deploy) }}
{% endif %}
{%- endmacro %}

{#- Keycloak — Polari realm, auto-scaffolded by kc_entrypoint.sh.
    knobs: image_tag, container_name, network, ports (absent = proxy-only),
    extra_env_file, java_opts, mode (KEYCLOAK_MODE), restart, deploy -#}
{%- macro keycloak(cfg, common) %}
  prf-keycloak:
    build:
      context: ./prf-keycloak
      dockerfile: Dockerfile.prf-kc
    container_name: {{ cfg.container_name | default('prf-keycloak') }}
    image: prf-keycloak:{{ cfg.image_tag }}
    networks:
      - {{ cfg.network | default(common.node_network) }}
{% if cfg.ports | default([]) %}
    ports:
{% for p in cfg.ports %}
      - "{{ p }}"
{% endfor %}
{% endif %}
    env_file:
      - {{ common.kc_admin_env }}
      # KC_DB_PASSWORD env var overrides the baked keycloak-prf.conf value,
      # keeping Keycloak in sync with the generated DB credentials.
      - {{ common.mariadb_env }}
{% for f in cfg.extra_env_file | default([]) %}
      - {{ f }}
{% endfor %}
    environment:
      - JAVA_OPTS_APPEND={{ cfg.java_opts }}
      - KEYCLOAK_MODE={{ cfg.mode }}
{% if cfg.restart is defined %}
    restart: "{{ cfg.restart }}"
{% endif %}
    depends_on:
      prf-mariadb:
        condition: service_healthy
    entrypoint: ["/opt/startup_shells/kc_entrypoint.sh"]
{% if cfg.deploy is defined %}
{{ deploy_resources(cfg.deploy) }}
{% endif %}
{%- endmacro %}

{#- nginx subdomain-routing proxy (TLS termination) — staging/prod only.
    knobs: image_tag, ports, nginx_conf (generated config path), deploy -#}
{%- macro proxy(cfg, common) %}
  prf-proxy:
    build:
      context: ./prf-proxy
      dockerfile: Dockerfile
      args:
        NGINX_CONF: nginx.dev.conf
    container_name: prf-proxy
    image: prf-proxy:{{ cfg.image_tag }}
    restart: always
    ports:
{% for p in cfg.ports %}
      - "{{ p }}"
{% endfor %}
    networks:
      - {{ cfg.network | default(common.node_network) }}
    volumes:
      - {{ cfg.nginx_conf }}:/etc/nginx/nginx.conf:ro
{% if cfg.deploy is defined %}
{{ deploy_resources(cfg.deploy) }}
{% endif %}
    depends_on:
      prf-keycloak:
        condition: service_started
      prf-file-store:
        condition: service_healthy
      frontend:
        condition: service_started
      backend:
        condition: service_healthy
{%- endmacro %}

{#- MinIO S3-compatible file store.
    knobs: image (stock image; absent = dockerfile_inline build tagged
    image_tag), ports, extra_env_file, inline_creds (MINIO_ROOT_* in
    environment vs env_file), explicit_command, deploy -#}
{%- macro file_store(cfg, common) %}
  prf-file-store:
{% if cfg.image is defined %}
    image: {{ cfg.image }}
{% else %}
    build:
      context: .
      dockerfile_inline: |
        FROM minio/minio:latest
        VOLUME /data
        EXPOSE 9000 9001
        CMD ["server", "/data", "--console-address", ":9001"]
    image: prf-file-store:{{ cfg.image_tag }}
{% endif %}
    container_name: prf-file-store
    restart: always
{% if cfg.ports | default([]) %}
    ports:
{% for p in cfg.ports %}
      - "{{ p }}"
{% endfor %}
{% endif %}
    networks:
      - {{ cfg.network | default(common.node_network) }}
{% for f in cfg.extra_env_file | default([]) %}
{% if loop.first %}
    env_file:
{% endif %}
      - {{ f }}
{% endfor %}
{% if cfg.inline_creds | default(false) %}
    environment:
      - MINIO_ROOT_USER={{ common.minio_user }}
      - MINIO_ROOT_PASSWORD={{ common.minio_password }}
{% endif %}
    volumes:
      - file-store-data:/data
{% if cfg.explicit_command | default(false) %}
    command: server /data --console-address ":9001"
{% endif %}
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      start_period: 10s
      interval: 10s
      timeout: 5s
      retries: 3
{% if cfg.deploy is defined %}
{{ deploy_resources(cfg.deploy) }}
{% endif %}
{%- endmacro %}

{#- Angular frontend, DEV flavour (base + stateless are identical).
    The ${VAR:-default} strings are runtime compose interpolation (Tier 2
    overrides) and stay literal here. knobs: network only. -#}
{%- macro frontend_dev(cfg, common) %}
  frontend:
    build:
      context: ./polari-platform-angular
      cache_from:
        - polari-platform-angular:latest
    container_name: prf-frontend
    env_file:
      - .env.defaults
      - .env
    environment:
      - BACKEND_URL=${BACKEND_URL:-localhost}
      - BACKEND_HTTP_PORT=${BACKEND_HTTP_PORT:-3000}
      - BACKEND_HTTPS_PORT=${BACKEND_HTTPS_PORT:-2096}
      - BACKEND_PREFER_HTTPS=${BACKEND_PREFER_HTTPS:-false}
      - FRONTEND_URL=${FRONTEND_URL:-localhost}
      - FRONTEND_HTTP_PORT=${FRONTEND_HTTP_PORT:-4200}
      - FRONTEND_HTTPS_PORT=${FRONTEND_HTTPS_PORT:-2087}
      - SSL_ENABLED=${SSL_ENABLED:-true}
      - SSL_CERT_PATH=/app/certs/prf-proxy.crt
      - SSL_KEY_PATH=/app/certs/prf-proxy.key
      - CONNECTION_RETRY_INTERVAL=${CONNECTION_RETRY_INTERVAL:-3000}
      - CONNECTION_MAX_RETRY_TIME=${CONNECTION_MAX_RETRY_TIME:-60000}
      - CONNECTION_TIMEOUT=${CONNECTION_TIMEOUT:-30000}
      - WEBSOCKET_URL=${BACKEND_URL:-localhost}
      - WEBSOCKET_PORT=${WEBSOCKET_PORT:-3001}
    ports:
      - "${FRONTEND_HTTP_PORT:-4201}:4200"
      - "${FRONTEND_HTTPS_PORT:-2087}:2087"
    networks:
      - {{ cfg.network | default(common.node_network) }}
    depends_on:
      - backend
    volumes:
      - frontend-dist:/project/dist
      - frontend-angular-cache:/project/.angular
      - ./prf-proxy/certs:/app/certs:ro
      - ./polari-platform-angular/src/assets/runtime-config.json:/project/src/assets/runtime-config.json:ro
{%- endmacro %}

{#- Python/Falcon backend, DEV flavour (base + stateless).
    knobs: stateful (true = sqlite + MinIO + data volumes + waits on
    file-store; false = tree-only storage, cert mount only), network -#}
{%- macro backend_dev(cfg, common) %}
  backend:
    build:
      context: ./polari-framework
      cache_from:
        - polari-framework:latest
    container_name: prf-backend
    env_file:
      - .env.defaults
      - .env
      - {{ common.kc_admin_env }}
    environment:
      - BACKEND_URL=${BACKEND_URL:-localhost}
      - BACKEND_HTTP_PORT=${BACKEND_HTTP_PORT:-3000}
      - BACKEND_HTTPS_PORT=${BACKEND_HTTPS_PORT:-2096}
      - BACKEND_APP_PORT=${BACKEND_HTTP_PORT:-3000}
      - FRONTEND_URL=${FRONTEND_URL:-localhost}
      - FRONTEND_HTTP_PORT=${FRONTEND_HTTP_PORT:-4200}
      - SSL_ENABLED=${SSL_ENABLED:-true}
      - SSL_CERT_PATH=/app/certs/prf-proxy.crt
      - SSL_KEY_PATH=/app/certs/prf-proxy.key
      - DEPLOY_ENV=${DEPLOY_ENV:-development}
      - IN_DOCKER_CONTAINER=true
      - LOG_LEVEL=${LOG_LEVEL:-INFO}
      - CORS_ENABLED=${CORS_ENABLED:-true}
      - WEBSOCKET_ENABLED=${WEBSOCKET_ENABLED:-true}
      - WEBSOCKET_PORT=${WEBSOCKET_PORT:-3001}
{% if cfg.stateful %}
      - DATABASE_TYPE=sqlite
      - DATABASE_PATH={{ common.database_path }}
      - OBJECT_STORAGE_ENABLED=true
      - MINIO_ENDPOINT={{ common.minio_endpoint }}
      - MINIO_ACCESS_KEY={{ common.minio_user }}
      - MINIO_SECRET_KEY={{ common.minio_password }}
{% else %}
      - DATABASE_TYPE=none
      - OBJECT_STORAGE_ENABLED=false
{% endif %}
    networks:
      - {{ cfg.network | default(common.node_network) }}
    ports:
      - "${BACKEND_HTTP_PORT:-3000}:3000"
      - "${BACKEND_HTTPS_PORT:-2096}:2096"
      - "${WEBSOCKET_PORT:-3001}:3001"
    volumes:
{% if cfg.stateful %}
      - backend-data:/app/data
      - backend-pycache:/app/__pycache__
{% endif %}
      - ./prf-proxy/certs:/app/certs:ro
{% if cfg.stateful %}
    depends_on:
      prf-file-store:
        condition: service_healthy
{% endif %}
{%- endmacro %}

{#- Angular frontend, STAGED flavour (staging-nip + prod: Dockerfile.prod
    build, generated runtime config, proxy-only ingress).
    knobs: image_tag, runtime_config, deploy, network -#}
{%- macro frontend_staged(cfg, common) %}
  frontend:
    build:
      context: ./polari-platform-angular
      dockerfile: Dockerfile.prod
    container_name: prf-frontend
    image: prf-frontend:{{ cfg.image_tag }}
    restart: always
    networks:
      - {{ cfg.network | default(common.node_network) }}
    volumes:
      - {{ cfg.runtime_config }}:/usr/share/nginx/html/assets/runtime-config.json:ro
{% if cfg.deploy is defined %}
{{ deploy_resources(cfg.deploy) }}
{% endif %}
    depends_on:
      - backend
{%- endmacro %}

{#- Python/Falcon backend, STAGED flavour (staging-nip + prod).
    knobs: image_tag, deploy_env, generated_env (env_file from
    staging-setup.sh / prod-setup.sh), minio_inline_creds (staging inlines
    MINIO_ACCESS/SECRET; prod takes them from .env.prod),
    healthcheck_start_period, extra_env (e.g. staging's MSCI_ENGINES_URL),
    deploy, network -#}
{%- macro backend_staged(cfg, common) %}
  backend:
    build:
      context: ./polari-framework
    container_name: prf-backend
    image: prf-backend:{{ cfg.image_tag }}
    restart: always
    networks:
      - {{ cfg.network | default(common.node_network) }}
    env_file:
      - {{ cfg.generated_env }}
      # Service-account secret for the polari-backend KC client. Without
      # this the backend can't authenticate to Keycloak's admin API and
      # the Role sync silently returns empty.
      - {{ common.kc_admin_env }}
    environment:
      - DEPLOY_ENV={{ cfg.deploy_env }}
      - IN_DOCKER_CONTAINER=true
      # API profiler self-call rewriting (avoids hairpin NAT)
      - INTERNAL_API_URL=http://localhost:3000
      # Database — SQLite enabled
      - DATABASE_TYPE=sqlite
      - DATABASE_PATH={{ common.database_path }}
      # Object Storage — MinIO enabled
      - OBJECT_STORAGE_ENABLED=true
      - MINIO_ENDPOINT={{ common.minio_endpoint }}
{% if cfg.minio_inline_creds %}
      - MINIO_ACCESS_KEY={{ common.minio_user }}
      - MINIO_SECRET_KEY={{ common.minio_password }}
{% endif %}
      # WebSocket (STOMP) notifications
      - WEBSOCKET_ENABLED=true
      - WEBSOCKET_PORT=3001
{% for e in cfg.extra_env | default([]) %}
      - {{ e }}
{% endfor %}
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:3000/', timeout=5)"]
      interval: 10s
      timeout: 10s
      start_period: {{ cfg.healthcheck_start_period }}
      retries: 5
    volumes:
      - backend-data:/app/data
{% if cfg.deploy is defined %}
{{ deploy_resources(cfg.deploy) }}
{% endif %}
    depends_on:
      prf-file-store:
        condition: service_healthy
{%- endmacro %}
