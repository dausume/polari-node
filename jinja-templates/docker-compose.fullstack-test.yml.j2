# GENERATED from jinja-templates/docker-compose.fullstack-test.yml.j2 —
# edit the template + setup.yml (variants.fullstack_test), then:
#   ansible-playbook jinja-gen/playbook.yml
# (env: {{ active_env_name }})
#
# POLARI RESEARCH FRAMEWORK - FULLSTACK TEST
# Frontend + backend tests together so frontend tests can make real API
# calls. Ephemeral — no persistent volumes; each run starts from a fresh
# realm import and a fresh MariaDB. `-test` container suffixes prevent
# name collisions with dev/staging stacks.
{% import 'compose_macros.jinja' as m %}
{% set v = variants.fullstack_test %}
{% set c = variants.common %}

services:
{{ m.mariadb(v.mariadb, c) }}

{{ m.keycloak(v.keycloak, c) }}

  # Backend framework tests (run first).
  polari-framework-tests:
    build:
      context: ./polari-framework
      dockerfile: Dockerfile.test
    container_name: polari-framework-tests
    networks:
      - {{ c.test_network }}
    healthcheck:
      test: ["CMD", "python", "-c", "import sys; sys.exit(0)"]
      interval: 5s
      timeout: 3s
      retries: 10
    restart: "no"

  # Backend API server for frontend integration testing.
  polari-framework-server:
    build:
      context: ./polari-framework
      dockerfile: Dockerfile
    container_name: polari-framework-server
    environment:
      - DEPLOY_ENV=test
      - BACKEND_APP_PORT={{ v.server_port }}
      - IN_DOCKER_CONTAINER=true
    networks:
      - {{ c.test_network }}
    ports:
      - "{{ v.server_port }}:{{ v.server_port }}"
    healthcheck:
      # Python check — no curl in the image.
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:{{ v.server_port }}/')"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
    # Keep server running for frontend tests.
    restart: "no"
    depends_on:
      polari-framework-tests:
        condition: service_completed_successfully

  # Frontend tests (run after the backend server is healthy).
  polari-frontend-tests:
    build:
      context: ./polari-platform-angular
      dockerfile: Dockerfile.test
    container_name: polari-frontend-tests
    environment:
      - TEST_MODE=fullstack
      - BACKEND_URL=http://polari-framework-server:{{ v.server_port }}
    networks:
      - {{ c.test_network }}
    volumes:
      - ./polari-platform-angular/src:/app/src:ro
      - ./polari-platform-angular/karma.conf.js:/app/karma.conf.js:ro
      - ./polari-platform-angular/angular.json:/app/angular.json:ro
      - ./polari-platform-angular/tsconfig.json:/app/tsconfig.json:ro
      - ./polari-platform-angular/tsconfig.spec.json:/app/tsconfig.spec.json:ro
      - ./polari-platform-angular/coverage:/app/coverage
    restart: "no"
    depends_on:
      polari-framework-server:
        condition: service_healthy

networks:
  {{ c.test_network }}:
    driver: bridge
    name: {{ c.test_network }}
