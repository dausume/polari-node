# GENERATED from jinja-templates/docker-compose.dask.yml.j2 —
# edit the template + setup.yml (variants.dask), then:
#   ansible-playbook jinja-gen/playbook.yml
# (env: {{ active_env_name }})
#
# The twin's Dask stack (DISTRIBUTED_COMPUTE_PLAN): one scheduler
# (conceptually on instance A) + one worker PER INSTANCE SIDE, all on the
# polari-link network the twin created. Reuses the backend image
# (dask[distributed] is in its requirements — version/code parity across
# workers guaranteed, zero additional image disk).
# Managed by:  ./twin-polari-build.sh dask-up | dask-down | dask-status
{% import 'compose_macros.jinja' as m %}
{% set v = variants.dask %}
{% set c = variants.common %}

networks:
  {{ c.link_network }}:
    external: true

services:
  dask-scheduler:
    image: {{ v.image }}
    container_name: {{ v.scheduler.container_name }}
    command: ["/opt/venv/bin/dask", "scheduler", "--port", "{{ v.scheduler.port }}", "--no-dashboard"]
    environment:
      - PYTHONPATH=/app
    networks:
      - {{ c.link_network }}
    mem_limit: {{ v.scheduler.mem_limit }}
    restart: unless-stopped
{% for w in v.workers %}

  # Instance {{ w.id | upper }}'s worker (on real multi-machine deployments this
  # service runs on that instance's hardware).
  dask-worker-{{ w.id }}:
    image: {{ v.image }}
    container_name: {{ w.container_name }}
    command: ["/opt/venv/bin/dask", "worker", "tcp://{{ v.scheduler.container_name }}:{{ v.scheduler.port }}",
              "--name", "{{ w.name }}", "--nthreads", "{{ v.worker.nthreads }}",
              "--memory-limit", "{{ v.worker.memory_limit }}", "--no-dashboard"]
    environment:
      - PYTHONPATH=/app
    networks:
      - {{ c.link_network }}
    mem_limit: {{ v.worker.mem_limit }}
    restart: unless-stopped
    depends_on:
      - dask-scheduler
{% endfor %}
