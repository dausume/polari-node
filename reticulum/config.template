# pol-reticulum RNS config (ret-2). Copied into /var/reticulum/config on
# first start ONLY — edit the live copy in the volume (or wipe the volume
# to re-seed from this template). No secrets: identities are generated
# into the volume at runtime, never committed (all repos are public).
#
# The ret-0-proven shape: a TCP server interface on the LAN. Radios
# (RNode/LoRa) are added per deployment against real DeviceLink rows —
# never seeded hopefully (§5j: udev facts, not guesses).

[reticulum]
  enable_transport = True
  share_instance = No
  panic_on_interface_error = No

[logging]
  loglevel = 3

[interfaces]
  # ret-7: zero-config wifi/LAN peering — AutoInterface discovers
  # peers on the local segment (link-local multicast), so two
  # sidecars on the same wifi network find each other with no
  # manual TCP client config. IP networking only — no radio, no
  # TX-legality concerns. NOTE: this template seeds the config on
  # FIRST start only; an existing volume keeps its live copy (add
  # the block there by hand, or wipe the volume to re-seed).
  [[Auto Discovery]]
    type = AutoInterface
    enabled = True

  [[TCP Server]]
    type = TCPServerInterface
    enabled = True
    listen_ip = 0.0.0.0
    listen_port = 4242
